build
build-*
# Keep the build-logs/ directory tracked (empty) without tracking any of the
# rolling per-arch log files (also caught by *.log below) that land in it.
!build-logs/
build-logs/*
!build-logs/.gitkeep
python-static-*
python-dynamic-*
deps
deps-*
tarballs
.DS_Store
*.out
*.log
venv
*.tar.gz
*.o
# qemu-user drops a core dump into the cwd when a target binary faults, and
# when that binary is being debugged by hand the cwd is the repo root.
qemu_*.core

compile_flags.txt
__pycache__
.perf_tmp

# staticpy writes everything here: fetched sources, extracted trees, published
# artifacts, logs, locks, and the binary the shim builds.
dist/
