-  const int err = pthread_mutex_lock(&lock->mutex);
-  if (err != 0) {
-    _mi_error_message(err, "internal error: lock cannot be acquired (err %i)\n", err);
+  uintptr_t me = mi_lock_self_token();
+  for (;;) {
+    uintptr_t expected = 0;
+    if (mi_atomic_cas_strong_acq_rel(&lock->mutex, &expected, me)) return;
+    // vanished owner (fork): token is a different pid
+    if (expected != 0 && expected != me &&
+        mi_atomic_cas_strong_acq_rel(&lock->mutex, &expected, me)) return;
+    _mi_prim_thread_yield();
   }
 }
 static inline void mi_lock_release(mi_lock_t* lock) {
-  pthread_mutex_unlock(&lock->mutex);
+  mi_atomic_store_release(&lock->mutex, (uintptr_t)0);
 }
