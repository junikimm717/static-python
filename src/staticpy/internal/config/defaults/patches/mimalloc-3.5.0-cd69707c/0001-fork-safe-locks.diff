pthread_mutex_t has no atfork: a child forked while another thread holds
a mi_lock_t inherits the owner and hangs on the next malloc. That is the
remaining CPython test_reinit_tls_after_fork hang on every triple whose
64-bit atomics take libatomic (eabi, rv32) once the libatomic table itself
is fixed. nomimalloc eabi passes; default (mimalloc) hangs.

Keep MI_USE_PTHREADS for TLS keys. Replace only the lock word with a
lock-free uintptr_t spinlock (32-bit on those triples) that stores
getpid() so the child steals a word left by a vanished thread. Same
shape as libat_atfork.c. See staticpy-traps LIBATOMIC_FORK.

--- a/include/mimalloc/atomic.h
+++ b/include/mimalloc/atomic.h
@@ -440,35 +440,45 @@
 
 #elif defined(MI_USE_PTHREADS)
 
-#include <string.h> // memcpy
+#include <unistd.h> // getpid
 void _mi_error_message(int err, const char* fmt, ...);
+void _mi_prim_thread_yield(void);
 
 typedef struct mi_lock_s {
-  pthread_mutex_t mutex;
+  _Atomic(uintptr_t) mutex;
 } mi_lock_t;
 
-#define MI_LOCK_INITIALIZER { PTHREAD_MUTEX_INITIALIZER }
+#define MI_LOCK_INITIALIZER   { MI_ATOMIC_VAR_INIT(0) }
+
+static inline uintptr_t mi_lock_self_token(void) {
+  uintptr_t u = (uintptr_t)getpid();
+  return (u != 0 ? u : (uintptr_t)1);
+}
 
 static inline bool mi_lock_try_acquire(mi_lock_t* lock) {
-  return (pthread_mutex_trylock(&lock->mutex) == 0);
+  uintptr_t expected = 0;
+  return mi_atomic_cas_strong_acq_rel(&lock->mutex, &expected, mi_lock_self_token());
 }
