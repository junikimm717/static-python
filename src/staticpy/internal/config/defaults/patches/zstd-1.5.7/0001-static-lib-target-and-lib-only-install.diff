Name the static archive and install only the library.

Top-level `make` builds the CLI (and may run tests); `make libzstd.a`
does not exist; `make install` also installs programs and requires a
shared object. A cross static build needs none of that.

--- a/Makefile
+++ b/Makefile
@@ -62,6 +62,11 @@
 lib lib-release lib-mt lib-nomt:
 	$(Q)$(MAKE) -C $(ZSTDDIR) $@
 
+# Named archive so a static build can ask for libzstd.a without the CLI.
+.PHONY: libzstd.a
+libzstd.a:
+	$(Q)$(MAKE) -C $(ZSTDDIR) libzstd.a
+
 .PHONY: zstd zstd-release
 zstd zstd-release:
 	$(Q)$(MAKE) -C $(PRGDIR) $@
@@ -180,9 +185,11 @@
 	} | column -t -s $$'\t'
 
 .PHONY: install armtest usan asan uasan msan asan32
+# Lib only: a cross build must not compile or install the CLI, and
+# install-shared is skipped unless the shared object was actually built.
 install:
-	$(Q)$(MAKE) -C $(ZSTDDIR) $@
-	$(Q)$(MAKE) -C $(PRGDIR) $@
+	$(Q)$(MAKE) -C $(ZSTDDIR) install-pc install-static install-includes
+	$(Q)if ls $(ZSTDDIR)/libzstd.so* >/dev/null 2>&1; then $(MAKE) -C $(ZSTDDIR) install-shared; fi
 
 .PHONY: uninstall
 uninstall:
