Drop the hard-coded toolchain and flag assignments so the cross toolenv wins.
PREFIX goes too: an absolute path here would be baked into the install.

--- a/Makefile
+++ b/Makefile
@@ -15,16 +15,10 @@
 SHELL=/bin/sh
 
 # To assist in cross-compiling
-CC=gcc
-AR=ar
-RANLIB=ranlib
-LDFLAGS=
 
 BIGFILES=-D_FILE_OFFSET_BITS=64
-CFLAGS=-Wall -Winline -O2 -g $(BIGFILES)
 
 # Where you want it installed when you do 'make install'
-PREFIX=/usr/local
 
 
 OBJS= blocksort.o  \
