#!/bin/sh
# Register qemu-user in the host kernel's binfmt_misc table so a target
# python re-exec (CPython's suite) is not ENOENT. staticpy itself execs
# qemu by path and does not need this.
#
# binfmt_misc is one global kernel table, not a namespaced one, so this
# needs a privileged container to reach a writable /proc/sys. On a host
# that already has an arch registered, a failed register means "already
# there" — the /usr/libexec/qemu-binfmt/<arch>-binfmt-P shims still
# point container re-execs at this image's qemu 11.1.1.
set -eu

BINFMT=/proc/sys/fs/binfmt_misc

# ELF magics from qemu 11.1.1 scripts/qemu-binfmt-conf.sh. The kernel
# parses the \xNN escapes; do not let the shell interpret them.
register() {
  arch=$1
  magic=$2
  mask=$3
  qemu=/usr/bin/qemu-$arch
  [ -x "$qemu" ] || return 0
  host=$(uname -m)
  if [ "$arch" = "$host" ]; then
    return 0
  fi
  if [ -e "$BINFMT/qemu-$arch" ]; then
    echo "binfmt: qemu-$arch already registered"
    return 0
  fi
  if ! printf '%s\n' ":qemu-${arch}:M::${magic}:${mask}:${qemu}:FCP" \
      > "$BINFMT/register" 2>/dev/null; then
    echo "binfmt: Failed to register qemu-$arch (already there?)"
  fi
}

start() {
  if [ ! -e "$BINFMT/register" ]; then
    mkdir -p "$BINFMT"
    mount -t binfmt_misc binfmt_misc "$BINFMT"
  fi
  register i386 \
    '\x7fELF\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x03\x00' \
    '\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
  register x86_64 \
    '\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x3e\x00' \
    '\xff\xff\xff\xff\xff\xfe\xfe\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
  register arm \
    '\x7fELF\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x28\x00' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
  register armeb \
    '\x7fELF\x01\x02\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x28' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff'
  register ppc64 \
    '\x7fELF\x02\x02\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x15' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff'
  register ppc64le \
    '\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x15\x00' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\x00'
  register s390x \
    '\x7fELF\x02\x02\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x16' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff'
  register aarch64 \
    '\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\xb7\x00' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
  register riscv32 \
    '\x7fELF\x01\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\xf3\x00' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
  register riscv64 \
    '\x7fELF\x02\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\xf3\x00' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff\xff'
  register mips64 \
    '\x7fELF\x02\x02\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x02\x00\x08' \
    '\xff\xff\xff\xff\xff\xff\xff\x00\x00\xff\xff\xff\xff\xff\xff\xff\xff\xfe\xff\xff'
}

case "${1:-start}" in
  start) start ;;
  *)
    echo "usage: binfmt start" >&2
    exit 1
    ;;
esac
